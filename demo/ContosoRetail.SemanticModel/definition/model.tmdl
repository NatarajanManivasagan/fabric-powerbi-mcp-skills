model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Date","Product","Customer","Sales","Metrics","dim_geography_region_master"]

ref table Date
ref table Product
ref table Customer
ref table Sales
ref table Metrics
ref table dim_geography_region_master

